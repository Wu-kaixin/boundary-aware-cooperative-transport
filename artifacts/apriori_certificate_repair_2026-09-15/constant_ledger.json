  "constants": {
    "a": {
      "formula": "2/k_c - Delta",
      "typical_value": 2.1722222222222225,
      "status": "rigorous",
      "domain": "k_c=0.9, Delta=0.05"
    },
    "M_plane": {
      "formula": "phi0*|D| + 2*pi*sigma^2*L",
      "status": "rigorous"
    },
    "B_H0": {
      "formula": "R^2 * M_plane",
      "status": "rigorous",
      "note": "H(P0) polar value is numerical_a_priori only and cannot issue rigorous_on_K0"
    },
    "M2_F1": {
      "formula": "(golden/sqrt(e) + sqrt(2 pi)) / sigma",
      "value_at_sigma_0p2": 17.440077486324686,
      "status": "rigorous",
      "domain": "sigma>0, all unit directions"
    },
    "M2_sigma2_k": {
      "formula": "1",
      "status": "rigorous",
      "domain": "sigma>0"
    },
    "max_edge": {
      "formula": "2 R",
      "status": "rigorous",
      "not_used": "2 R sin(pi/n_gon)"
    },
    "dm_trap": {
      "formula": "N * W * 2 pi R * h_max^2 * M2_F1 / 12",
      "status": "rigorous"
    },
    "dmu_robot": {
      "formula": "dmu_xi + (R + cull_sigmas sigma) dm_trap",
      "status": "rigorous"
    },
    "B_E": {
      "formula": "min(2R(dmu_robot + R dm) + R^2(dm + N eps), 4 R^2 M_plane)",
      "status": "rigorous"
    },
    "B_J_prior": {
      "formula": "2 B_H0 / (a K Delta) + 4 B_E / a^2",
      "status": "rigorous_on_K0",
      "requires": "full-horizon K0 on original unclamped rho rows"
    },
    "B_J_geom": {
      "formula": "M_plane * u_max^2",
      "status": "rigorous"
    }
  },

+def test_hold_segment_min_distance_matches_linear_geometry():
+    p1 = np.array([0.0, 0.0])
+    p2 = np.array([1.0, 0.0])
+    u1 = np.array([0.0, 0.0])
+    u2 = np.array([-1.0, 0.0])
+    assert hold_segment_min_distance(p1, p2, u1, u2, 0.5) == pytest.approx(0.5)
